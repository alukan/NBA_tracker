{
  "name": "nba-schedule-app",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:knip": "knip"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@ds$": "<rootDir>/src/design-system/index.ts",
      "^@ds/(.*)$": "<rootDir>/src/design-system/$1",
      "^@shared$": "<rootDir>/src/shared/index.ts",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "~56.0.0",
    "expo-dev-client": "~56.0.18",
    "expo-haptics": "~56.0.3",
    "expo-notifications": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@christopherjbaker/eslint-config": "^3.1.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-plugin-expo": "^1.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
